<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr"
    android:padding="8dp" android:background="@android:color/transparent">
    <TextClock android:id="@+id/hours" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="HH" android:format24Hour="HH" android:textSize="48sp"
        android:fontFamily="@font/long_arabic" android:textScaleX="1.15" android:textColor="#FFFFFF"
        android:singleLine="true" android:gravity="center" android:importantForAccessibility="yes" />
    <TextView android:id="@+id/separator" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text=":" android:textSize="48sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light"
        android:paddingLeft="3dp" android:paddingRight="3dp" android:importantForAccessibility="no" />
    <TextClock android:id="@+id/minutes" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="mm" android:format24Hour="mm" android:textSize="48sp"
        android:fontFamily="@font/long_arabic" android:textScaleX="1.15" android:textColor="#FFFFFF"
        android:singleLine="true" android:gravity="center" android:importantForAccessibility="yes" />
</LinearLayout>
